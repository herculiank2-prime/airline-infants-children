<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Travel questions"
    sling:resourceType="cq/gui/components/authoring/dialog"
    extraClientlibs="[cq.authoring.dialog.all]">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <content
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Content"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Section heading"
                                fieldDescription="For example: Booking for infants (under 2 years). The heading level is set by the template."
                                name="./heading"
                                required="{Boolean}true"/>
                            <id
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="ID"
                                fieldDescription="Section ID used by the hero&apos;s On this page links, for example booking-infants."
                                name="./id"/>
                            <expandFirst
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                name="./expandFirst"
                                text="Open the first question when the page loads"
                                uncheckedValue="false"
                                value="{Boolean}true"/>
                            <expandFirstType
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                name="./expandFirst@TypeHint"
                                value="Boolean"/>
                        </items>
                    </content>
                    <questions
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Questions"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <source
                                granite:class="cq-dialog-dropdown-showhide"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Choose questions by"
                                name="./source">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    cq-dialog-dropdown-showhide-target=".airline-tq-source"/>
                                <items jcr:primaryType="nt:unstructured">
                                    <folder
                                        jcr:primaryType="nt:unstructured"
                                        text="Folder"
                                        value="folder"/>
                                    <tags
                                        jcr:primaryType="nt:unstructured"
                                        text="Tags"
                                        value="tags"/>
                                </items>
                            </source>
                            <folderSettings
                                granite:class="hide airline-tq-source"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    showhidetargetvalue="folder"/>
                                <items jcr:primaryType="nt:unstructured">
                                    <folderPath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Folder"
                                        fieldDescription="Every travel question in this folder and its subfolders is shown."
                                        name="./folderPath"
                                        rootPath="/content/dam/airline/travel-questions"/>
                                </items>
                            </folderSettings>
                            <tagSettings
                                granite:class="hide airline-tq-source"
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    showhidetargetvalue="tags"/>
                                <items jcr:primaryType="nt:unstructured">
                                    <tags
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                                        fieldLabel="Tags"
                                        fieldDescription="Questions tagged with exactly these tags. A parent tag does not include its children."
                                        multiple="{Boolean}true"
                                        name="./tags"
                                        rootPath="/content/cq:tags/airline"/>
                                    <tagMatch
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                        fieldLabel="Match"
                                        name="./tagMatch">
                                        <items jcr:primaryType="nt:unstructured">
                                            <any
                                                jcr:primaryType="nt:unstructured"
                                                text="Any of the tags"
                                                value="any"/>
                                            <all
                                                jcr:primaryType="nt:unstructured"
                                                text="All of the tags"
                                                value="all"/>
                                        </items>
                                    </tagMatch>
                                    <rootPath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        emptyText="/content/dam/airline/travel-questions"
                                        fieldLabel="Search in"
                                        fieldDescription="Optional. Leave blank to search all travel questions."
                                        name="./rootPath"
                                        rootPath="/content/dam/airline/travel-questions"/>
                                </items>
                            </tagSettings>
                            <maxItems
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Maximum questions"
                                fieldDescription="1 to 20."
                                max="{Long}20"
                                min="{Long}1"
                                name="./maxItems"
                                value="{Long}20"/>
                            <maxItemsType
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                name="./maxItems@TypeHint"
                                value="Long"/>
                        </items>
                    </questions>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
