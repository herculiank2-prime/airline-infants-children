{
  "alloworigin": ["$[env:AIRLINE_GRAPHQL_ALLOWED_ORIGIN;default=https://app.airline.example]"],
  "allowedpaths": ["/graphql/execute.json/airline/.*"],
  "supportedheaders": ["Origin", "Accept", "Content-Type", "If-None-Match"],
