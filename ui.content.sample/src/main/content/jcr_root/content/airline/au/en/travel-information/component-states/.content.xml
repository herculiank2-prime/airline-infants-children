<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:robotsTags="[noindex,nofollow]"
        cq:template="/conf/airline/settings/wcm/templates/travel-information-page"
        jcr:description="Reviewer page: alternative component states. Not for visitors."
        jcr:primaryType="cq:PageContent"
        jcr:title="Component states"
        hideInNav="{Boolean}true"
        sling:resourceType="airline/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="airline/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/container"
                layout="responsiveGrid">
                <hero
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Component states"
                    sling:resourceType="airline/components/hero"
                    fileReference="/content/dam/airline/travel-information/infants-children/family-hero.jpg"
                    id="hero"
                    introduction="Decorative hero image, a folder-mode accordion with the first item open, and an accordion with no source."
                    isDecorative="{Boolean}true"/>
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="airline/components/container"
                    layout="responsiveGrid">
                    <folder_mode
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="airline/components/travelquestions"
                        expandFirst="{Boolean}true"
                        folderPath="/content/dam/airline/travel-questions/infants"
                        heading="Folder mode, first three, first open"
                        id="folder-mode"
                        maxItems="{Long}3"
                        source="folder"/>
                    <unconfigured
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="airline/components/travelquestions"
                        heading="No source chosen: renders nothing on publish"
                        id="unconfigured"/>
                </content>
            </container>
        </root>
    </jcr:content>
</jcr:root>
