<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/airline/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="airline/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="airline/components/container"
            layout="simple">
            <logo
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/image"
                alt="Home, Qantas Airways Logo"
                altValueFromDAM="{Boolean}false"
                fileReference="/content/dam/airline/brand/qantas-logo.svg"
                id="site-logo"
                linkURL="/content/airline/au/en"/>
            <partner
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/image"
                alt="Qantas and oneworld travel alliance"
                altValueFromDAM="{Boolean}false"
                fileReference="/content/dam/airline/brand/oneworld-logo.svg"
                id="site-partner"
                linkURL="https://www.qantas.com/en-au/where-we-fly/partner-airlines/oneworld"/>
            <mainnav
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/container"
                accessibilityLabel="Main"
                id="main-navigation"
                layout="simple"
                roleAttribute="navigation">
                <links
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="airline/components/list"
                    linkItems="{Boolean}true"
                    listFrom="static">
                    <static jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            linkText="Flights"
                            linkURL="https://www.qantas.com/en-au/book/flights"/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            linkText="Travel"
                            linkURL="https://www.qantas.com/en-au/where-we-fly"/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            linkText="Shop"
                            linkURL="https://marketplace.qantas.com/au"/>
                        <item3
                            jcr:primaryType="nt:unstructured"
                            linkText="Banking &amp; Insurance"
                            linkURL="https://www.qantasmoney.com/"/>
                        <item4
                            jcr:primaryType="nt:unstructured"
                            linkText="Frequent Flyer"
                            linkURL="https://www.qantas.com/en-au/frequent-flyer"/>
                    </static>
                </links>
            </mainnav>
            <actions
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/container"
                id="site-actions"
                layout="simple">
                <managebooking
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Manage booking"
                    sling:resourceType="airline/components/button"
                    linkURL="https://www.qantas.com/en-au/manage-booking"/>
                <login
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Log in"
                    sling:resourceType="airline/components/button"
                    cq:styleIds="[button-primary]"
                    linkURL="https://www.qantas.com/en-au/frequent-flyer/log-in"
                    trackingEvent="airline:header:login"
                    trackingLabel="Header - Log in"/>
            </actions>
        </root>
    </jcr:content>
</jcr:root>
