<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/airline/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Footer"
        sling:resourceType="airline/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="airline/components/container"
            layout="simple">
            <brand
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/container"
                id="footer-brand"
                layout="simple">
                <backtotop
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Back to top"
                    sling:resourceType="airline/components/button"
                    cq:styleIds="[button-link-up]"
                    linkURL="#main-content"/>
                <logo
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="airline/components/image"
                    alt="Home, Qantas Airways Logo"
                    altValueFromDAM="{Boolean}false"
                    fileReference="/content/dam/airline/brand/qantas-logo.svg"
                    linkURL="/content/airline/au/en"/>
            </brand>
            <primarylinks
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/list"
                id="footer-primary-links"
                linkItems="{Boolean}true"
                listFrom="static"
                trackingEvent="airline:footer:link"
                trackingLabel="Footer - primary links">
                <static jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            linkText="About us"
                            linkURL="https://www.qantas.com/en-au/about-us"/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            linkText="Qantas Group"
                            linkURL="https://www.qantas.com/au/en/qantas-group.html"/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            linkText="Support"
                            linkURL="https://www.qantas.com/en-au/help"/>
                        <item3
                            jcr:primaryType="nt:unstructured"
                            linkText="Qantas App"
                            linkURL="https://www.qantas.com/en-au/qantas-app"/>
                        <item4
                            jcr:primaryType="nt:unstructured"
                            linkText="Connect with us"
                            linkURL="https://www.qantas.com/en-au/help/contact-us"/>
                </static>
            </primarylinks>
            <legallinks
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/list"
                id="footer-legal-links"
                linkItems="{Boolean}true"
                listFrom="static">
                <static jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            linkText="Privacy &amp; security"
                            linkURL="https://www.qantas.com/en-au/support/privacy-and-security"/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            linkText="Terms of Use"
                            linkURL="https://www.qantas.com/en-au/support/terms-of-use"/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            linkText="Conditions of Carriage"
                            linkURL="https://www.qantas.com/en-au/support/conditions-of-carriage"/>
                        <item3
                            jcr:primaryType="nt:unstructured"
                            linkText="Modern Slavery Act Statement (PDF)"
                            linkURL="https://www.qantas.com/en-au/qantas-group/acting-responsibly"/>
                        <item4
                            jcr:primaryType="nt:unstructured"
                            linkText="Reconciliation Action Plan"
                            linkURL="https://www.qantas.com/en-au/qantas-group/acting-responsibly/reconciliation"/>
                        <item5
                            jcr:primaryType="nt:unstructured"
                            linkText="Access &amp; Inclusion Plan"
                            linkURL="https://www.qantas.com/en-au/travel-information/specific-needs-assistance"/>
                        <item6
                            jcr:primaryType="nt:unstructured"
                            linkText="Fare types"
                            linkURL="https://www.qantas.com/en-au/book/flights/fare-types"/>
                </static>
            </legallinks>
            <legal
                jcr:primaryType="nt:unstructured"
                sling:resourceType="airline/components/text"
                text="&lt;p&gt;&amp;copy; Qantas Airways Limited ABN 16 009 661 901&lt;/p&gt;&lt;p&gt;Qantas would like to acknowledge the Traditional Custodians of the local lands and waterways on which we live, work and fly. We pay our respects to Elders past and present.&lt;/p&gt;"
                textIsRich="true"/>
        </root>
    </jcr:content>
</jcr:root>