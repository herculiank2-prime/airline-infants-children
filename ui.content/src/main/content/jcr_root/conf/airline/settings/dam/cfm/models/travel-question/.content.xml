<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/entities(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:description="A question and answer shown in travel information accordions, FAQ structured data and persisted queries (HD-01, ADR-002, ADR-016)."
        jcr:primaryType="cq:PageContent"
        jcr:title="Travel question"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default"
        isLocked="{Boolean}false"
        status="enabled">
        <metadata jcr:primaryType="nt:unstructured"/>
        <model
            cq:targetPath="/content/entities"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="20">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/container">
                    <items jcr:primaryType="nt:unstructured">
                        <question
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldDescription="Shown as the accordion button and as the FAQ question. Write it as the visitor would ask it."
                            fieldLabel="Question"
                            listOrder="1"
                            maxlength="255"
                            metaType="text-single"
                            name="question"
                            renderReadOnly="false"
                            required="on"
                            showEmptyInReadOnly="true"
                            valueType="string">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </question>
                        <answer
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
                            cfm-element="Answer"
                            default-mime-type="text/html"
                            fieldDescription="Paragraphs, lists, bold, italic and links only. Other formatting is removed on the page."
                            listOrder="2"
                            metaType="text-multi"
                            name="answer"
                            renderReadOnly="false"
                            required="on"
                            showEmptyInReadOnly="true"
                            valueType="string/multiline">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </answer>
                        <tags
                            cq:showOnCreate="true"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="cq/gui/components/coral/common/form/tagfield"
                            autocreateTag="false"
                            fieldDescription="Audience and market, for example Infants and Australia. Accordions in tag mode match these exact tags."
                            fieldLabel="Tags"
                            forceSelection="true"
                            listOrder="3"
                            metaType="tags"
                            multiple="true"
                            name="tags"
                            renderReadOnly="false"
                            rootPath="/content/cq:tags/airline"
                            showEmptyInReadOnly="true"
                            valueType="string/tags[]"/>
                        <sortOrder
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                            fieldDescription="Lower numbers appear first. Use steps of 10 so items can be inserted later."
                            fieldLabel="Sort order"
                            listOrder="4"
                            metaType="number"
                            min="0"
                            name="sortOrder"
                            renderReadOnly="false"
                            required="on"
                            showEmptyInReadOnly="true"
                            step="1"
                            typeHint="long"
                            value="100"
                            valueType="long">
                            <granite:data jcr:primaryType="nt:unstructured"/>
                        </sortOrder>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
