<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:rep="internal"
    jcr:mixinTypes="[rep:AccessControllable]"
    jcr:primaryType="cq:Page">
    <rep:policy/>
    <airline jcr:primaryType="nt:unstructured">
        <components jcr:primaryType="nt:unstructured">
            <page jcr:primaryType="nt:unstructured">
                <policy
                    jcr:description="Client libraries, JS in the footer, skip link to #main-content."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Airline Page"
                    sling:resourceType="wcm/core/components/policy/policy"
                    clientlibs="[airline.dependencies,airline.site]"
                    clientlibsJsHead="airline.dependencies"
                    mainContentSelector="main-content">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy>
            </page>
            <container jcr:primaryType="nt:unstructured">
                <policy_page_root
                    jcr:description="Template root. Holds the header XF, main and footer XF; authors add nothing here."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Page Root"
                    sling:resourceType="wcm/core/components/policy/policy">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_page_root>
                <policy_main
                    cq:styleDefaultElement="main"
                    jcr:description="Renders the &lt;main> landmark (ADR-008)."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Page Main"
                    sling:resourceType="wcm/core/components/policy/policy">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_main>
                <policy_content
                    jcr:description="Travel information content area: sections, rich text, image-and-text teasers and travel questions."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Travel Information Content"
                    sling:resourceType="wcm/core/components/policy/policy"
                    components="[/apps/airline/components/teaser,/apps/airline/components/travelquestions,/apps/airline/components/text,/apps/airline/components/container]">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_content>
                <policy_section
                    jcr:description="Page section: groups a heading, text, teasers and travel questions (ADR-029)."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Content Section"
                    sling:resourceType="wcm/core/components/policy/policy"
                    components="[/apps/airline/components/teaser,/apps/airline/components/travelquestions,/apps/airline/components/text,/apps/airline/components/container]"
                    layout="simple">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                    <cq:styleGroups jcr:primaryType="nt:unstructured">
                        <item0
                            cq:styleGroupLabel="Section"
                            jcr:primaryType="nt:unstructured">
                            <cq:styles jcr:primaryType="nt:unstructured">
                                <item0
                                    cq:styleClasses="cmp-section--grey"
                                    cq:styleId="section-grey"
                                    cq:styleLabel="Grey offset section"
                                    jcr:primaryType="nt:unstructured"/>
                                <item1
                                    cq:styleClasses="cmp-section--two-col"
                                    cq:styleId="section-two-col"
                                    cq:styleLabel="Two columns"
                                    jcr:primaryType="nt:unstructured"/>
                            </cq:styles>
                        </item0>
                    </cq:styleGroups>
                </policy_section>
                <policy_xf_root
                    jcr:description="Experience fragment root: logos, navigation list, buttons, link lists and legal text (ADR-030)."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="XF Root"
                    sling:resourceType="wcm/core/components/policy/policy"
                    components="[/apps/airline/components/image,/apps/airline/components/container,/apps/airline/components/list,/apps/airline/components/button,/apps/airline/components/text]">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_xf_root>
                <policy_xf_group
                    jcr:description="Group inside a header or footer: main navigation (role navigation), actions or brand."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="XF Group"
                    sling:resourceType="wcm/core/components/policy/policy"
                    components="[/apps/airline/components/image,/apps/airline/components/list,/apps/airline/components/button]"
                    layout="simple">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_xf_group>
                <policy_hero_links
                    jcr:description="Links area inside the hero: holds the jump links component (ADR-030)."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Hero Links"
                    sling:resourceType="wcm/core/components/policy/policy"
                    components="[/apps/airline/components/jumplinks]"
                    layout="simple">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_hero_links>                <policy_xf_group
                    jcr:description="Group inside a header or footer: main navigation (role navigation), actions or brand."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="XF Group"
                    sling:resourceType="wcm/core/components/policy/policy"
                    components="[/apps/airline/components/image,/apps/airline/components/list,/apps/airline/components/button]"
                    layout="simple">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_xf_group>
                <policy_hero_links
                    jcr:description="Links area inside the hero: holds the jump links component (ADR-030)."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Hero Links"
                    sling:resourceType="wcm/core/components/policy/policy"
                    components="[/apps/airline/components/jumplinks]"
                    layout="simple">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_hero_links>            </container>
            <experiencefragment jcr:primaryType="nt:unstructured">
                <policy_header
                    cq:styleDefaultElement="header"
                    jcr:description="Renders the header experience fragment as a &lt;header> landmark."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Page Header"
                    sling:resourceType="wcm/core/components/policy/policy">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_header>
                <policy_footer
                    cq:styleDefaultElement="footer"
                    jcr:description="Renders the footer experience fragment as a &lt;footer> landmark."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Page Footer"
                    sling:resourceType="wcm/core/components/policy/policy">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_footer>
            </experiencefragment>
            <navigation jcr:primaryType="nt:unstructured">
                <policy_header_nav
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Header Navigation"
                    sling:resourceType="wcm/core/components/policy/policy"
                    navigationRoot="/content/airline/au/en"
                    skipNavigationRoot="{Boolean}false"
                    structureDepth="{Long}2"
                    structureStart="{Long}0">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_header_nav>
            </navigation>
            <image jcr:primaryType="nt:unstructured">
                <policy_content_image
                    jcr:description="Teaser image delegate: lazy loading, responsive widths, alt from DAM."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Content Image"
                    sling:resourceType="wcm/core/components/policy/policy"
                    allowedRenditionWidths="[320,480,640,960,1280]"
                    allowUpload="false"
                    altValueFromDAM="true"
                    disableLazyLoading="false"
                    displayPopupTitle="false"
                    enableAssetDelivery="false"
                    isDecorative="false"
                    jpegQuality="{Long}80"
                    titleValueFromDAM="false"
                    uuidDisabled="true">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_content_image>
            </image>
            <text jcr:primaryType="nt:unstructured">
                <policy_footer_text
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Footer Text"
                    sling:resourceType="wcm/core/components/policy/policy">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                    <rtePlugins jcr:primaryType="nt:unstructured">
                        <format jcr:primaryType="nt:unstructured" features="bold,italic"/>
                        <links jcr:primaryType="nt:unstructured" features="modifylink,unlink"/>
                        <lists jcr:primaryType="nt:unstructured" features="*"/>
                        <misctools jcr:primaryType="nt:unstructured" features="sourceedit"/>
                    </rtePlugins>
                </policy_footer_text>
                <policy_content_text
                    jcr:description="Section copy: headings H2-H4, lists, links and the alert, card and related-links styles."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Content Text"
                    sling:resourceType="wcm/core/components/policy/policy">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                    <cq:styleGroups jcr:primaryType="nt:unstructured">
                        <item0
                            cq:styleGroupLabel="Presentation"
                            jcr:primaryType="nt:unstructured">
                            <cq:styles jcr:primaryType="nt:unstructured">
                                <item0
                                    cq:styleClasses="cmp-text--alert"
                                    cq:styleId="text-alert"
                                    cq:styleLabel="Information alert"
                                    jcr:primaryType="nt:unstructured"/>
                                <item1
                                    cq:styleClasses="cmp-text--card"
                                    cq:styleId="text-card"
                                    cq:styleLabel="Card"
                                    jcr:primaryType="nt:unstructured"/>
                                <item2
                                    cq:styleClasses="cmp-text--related"
                                    cq:styleId="text-related"
                                    cq:styleLabel="Related links"
                                    jcr:primaryType="nt:unstructured"/>
                                <item3
                                    cq:styleClasses="cmp-text--intro"
                                    cq:styleId="text-intro"
                                    cq:styleLabel="Section introduction"
                                    jcr:primaryType="nt:unstructured"/>
                            </cq:styles>
                        </item0>
                        <item1
                            cq:styleGroupLabel="Card icon"
                            jcr:primaryType="nt:unstructured">
                            <cq:styles jcr:primaryType="nt:unstructured">
                                <item0
                                    cq:styleClasses="cmp-text--icon-airport"
                                    cq:styleId="text-icon-airport"
                                    cq:styleLabel="Airport"
                                    jcr:primaryType="nt:unstructured"/>
                                <item1
                                    cq:styleClasses="cmp-text--icon-baby-bottle"
                                    cq:styleId="text-icon-baby-bottle"
                                    cq:styleLabel="Baby bottle"
                                    jcr:primaryType="nt:unstructured"/>
                            </cq:styles>
                        </item1>
                    </cq:styleGroups>
                    <rtePlugins jcr:primaryType="nt:unstructured">
                        <format jcr:primaryType="nt:unstructured" features="bold,italic"/>
                        <links jcr:primaryType="nt:unstructured" features="modifylink,unlink"/>
                        <lists jcr:primaryType="nt:unstructured" features="*"/>
                        <misctools jcr:primaryType="nt:unstructured" features="sourceedit"/>
                        <paraformat jcr:primaryType="nt:unstructured" features="*"/>
                    </rtePlugins>
                </policy_content_text>
            </text>
            <button jcr:primaryType="nt:unstructured">
                <policy_default
                    jcr:description="Header and footer actions."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Button"
                    sling:resourceType="wcm/core/components/policy/policy">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                    <cq:styleGroups jcr:primaryType="nt:unstructured">
                        <item0
                            cq:styleGroupLabel="Appearance"
                            jcr:primaryType="nt:unstructured">
                            <cq:styles jcr:primaryType="nt:unstructured">
                                <item0
                                    cq:styleClasses="cmp-button--primary"
                                    cq:styleId="button-primary"
                                    cq:styleLabel="Primary (red pill)"
                                    jcr:primaryType="nt:unstructured"/>
                                <item1
                                    cq:styleClasses="cmp-button--back-to-top"
                                    cq:styleId="button-link-up"
                                    cq:styleLabel="Back to top link"
                                    jcr:primaryType="nt:unstructured"/>
                            </cq:styles>
                        </item0>
                    </cq:styleGroups>
                </policy_default>
            </button>
            <list jcr:primaryType="nt:unstructured">
                <policy_default
                    jcr:description="Header navigation and footer link rows: fixed list of links."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Link List"
                    sling:resourceType="wcm/core/components/policy/policy"
                    disableChildren="{Boolean}false"
                    disableSearch="{Boolean}true"
                    disableTags="{Boolean}true"
                    showDescription="{Boolean}false"
                    showModificationDate="{Boolean}false">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_default>
            </list>
            <breadcrumb jcr:primaryType="nt:unstructured">                <policy_default
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Breadcrumb"
                    sling:resourceType="wcm/core/components/policy/policy"
                    hideCurrent="{Boolean}false"
                    showHidden="{Boolean}false"
                    startLevel="{Long}3">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_default>
            </breadcrumb>
            <teaser jcr:primaryType="nt:unstructured">
                <policy_joeyclub
                    jcr:description="Promotional teaser: H2 title fixed by policy, no pretitle, one or more CTAs (TS-01)."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Promotional Teaser"
                    sling:resourceType="wcm/core/components/policy/policy"
                    actionsDisabled="{Boolean}false"
                    descriptionHidden="{Boolean}false"
                    imageDelegate="airline/components/image"
                    imageLinkHidden="{Boolean}true"
                    pretitleHidden="{Boolean}true"
                    showTitleType="{Boolean}true"
                    titleHidden="{Boolean}false"
                    titleLinkHidden="{Boolean}true"
                    titleType="h2">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                    <cq:styleGroups jcr:primaryType="nt:unstructured">
                        <item0
                            cq:styleGroupLabel="Image position"
                            jcr:primaryType="nt:unstructured">
                            <cq:styles jcr:primaryType="nt:unstructured">
                                <item0
                                    cq:styleClasses="cmp-teaser--image-left"
                                    cq:styleId="teaser-image-left"
                                    cq:styleLabel="Image left"
                                    jcr:primaryType="nt:unstructured"/>
                                <item1
                                    cq:styleClasses="cmp-teaser--image-right"
                                    cq:styleId="teaser-image-right"
                                    cq:styleLabel="Image right"
                                    jcr:primaryType="nt:unstructured"/>
                                <item2
                                    cq:styleClasses="cmp-teaser--stacked"
                                    cq:styleId="teaser-stacked"
                                    cq:styleLabel="Image above text"
                                    jcr:primaryType="nt:unstructured"/>
                            </cq:styles>
                        </item0>
                    </cq:styleGroups>
                </policy_joeyclub>
            </teaser>
            <travelquestions jcr:primaryType="nt:unstructured">
                <policy_default
                    jcr:description="Section heading H2, question headings H3."
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Travel Questions"
                    sling:resourceType="wcm/core/components/policy/policy"
                    headingElement="h2"
                    itemHeadingElement="h3">
                    <jcr:content jcr:primaryType="nt:unstructured"/>
                </policy_default>
            </travelquestions>
        </components>
    </airline>
</jcr:root>
