<?xml version="1.0" encoding="UTF-8"?>
<!--
  Code-owned structure only (ADR-019). Demo pages, XFs, fragments and images live in ui.content.sample.
  update  = deployed definitions win, nodes created by authors under the root are kept
  replace = the definition in Git is the only truth
  merge   = only adds what does not exist yet
-->
<workspaceFilter version="1.0">
    <filter root="/conf/airline/settings/wcm/template-types" mode="update"/>
    <filter root="/conf/airline/settings/wcm/templates" mode="update"/>
    <filter root="/conf/airline/settings/wcm/policies" mode="update"/>
    <filter root="/conf/airline/settings/dam/cfm/models/travel-question" mode="replace"/>
    <filter root="/conf/airline/settings/graphql/persistentQueries" mode="replace"/>
    <filter root="/conf/airline/settings/cloudconfigs" mode="merge"/>
    <filter root="/conf/airline/sling:configs" mode="merge"/>
    <filter root="/content/cq:tags/airline" mode="merge"/>
    <filter root="/content/cq:graphql/airline" mode="merge"/>
</workspaceFilter>
